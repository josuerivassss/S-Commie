# Port the server listens on. Pterodactyl injects this automatically via its egg variables;
# for local/VSC development you can set it manually.
PORT=3000

# Optional: Discord webhook URL for request logging (leave empty/unset to disable).
WEBHOOK=

# Log verbosity: error | warn | info | debug | trace
RUST_LOG=info

# Mongo
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=bcommie

INTERNAL_ADMIN_SECRET=